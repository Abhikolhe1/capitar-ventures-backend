HOST=0.0.0.0
PORT=3035
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Newsletter email (sent to subscribers when a new Blog Article is published).
# Leave SMTP_HOST empty to disable sending. Examples:
#   Gmail / Google Workspace: smtp.gmail.com, 587, SMTP_SECURE=false, an App Password (not the normal password)
#   Outlook / Microsoft 365:  smtp.office365.com, 587, SMTP_SECURE=false
#   Zoho Mail (India):        smtp.zoho.in, 465, SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Capitar Ventures <news@example.com>"
SMTP_REPLY_TO=
# Public addresses used inside the emails (article links, images, unsubscribe link).
PUBLIC_SITE_URL=http://localhost:3039
PUBLIC_CMS_URL=http://localhost:3035
